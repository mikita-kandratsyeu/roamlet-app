# Public client-side key: visible to browser users. Never use a private server credential.
# Obtain an ORS key through https://account.heigit.org (linked from openrouteservice.org).
VITE_ORS_API_KEY=
VITE_ORS_URL=https://api.openrouteservice.org
# Optional compliant hosted raster provider. Defaults below are for low-traffic development only.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=© OpenStreetMap contributors
VITE_TILE_MAX_ZOOM=19
