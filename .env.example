# Server-only OpenRouteService key. Copy this file to root .env.local for yarn dev.
# In Vercel, configure ORS_API_KEY as a Sensitive environment variable and redeploy.
# Never prefix this key with VITE_ or commit actual keys.
ORS_API_KEY=

# Optional GitHub App connector, all server-only; never use VITE_ prefixes.
# Configure Contents: read/write and Metadata: read; install on selected private repos.
# Enable expiring user access tokens. PKCE S256 is used; refresh tokens are NOT stored.
# Sessions expire after at most 8 hours; reconnect afterward. No DB or plaintext backup storage.
# Use separate App credentials/session keys for development and production.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Exact registered callback: https://your-domain/api/github?action=callback
# Local development only: http://127.0.0.1:5173/api/github?action=callback
GITHUB_APP_CALLBACK_URL=
# Base64 of exactly 32 random bytes; generate locally (never commit the output):
# node --input-type=module -e "import { randomBytes } from 'node:crypto'; console.log(randomBytes(32).toString('base64'))"
# Changing this secret invalidates all cookies. Configure secrets as Sensitive on Vercel.
GITHUB_SESSION_SECRET=
# Only encrypted ROAMLET v1 containers are relayed; transport maximum is 3 MiB.
# Complete discovery is capped at 100 installations/100 accessible repositories; larger listings fail.
# Directory listing rejects 1000 entries; upload refuses 999 total entries before writing.
# Directory preflight is not a cross-device lock; no automatic retries/deletion/retention.
# Logout clears browser cookies and best-effort revokes only the current GitHub user token.
# No application logs contain secrets; exclude OAuth callback queries/cookies from deployment logs.

# Optional Google Drive connector, server-only. Enable Google Drive API in Google Cloud.
# Create an OAuth client of type Web application; configure consent and test users if Testing.
# Exact scopes: openid email https://www.googleapis.com/auth/drive.appdata
# Hidden appDataFolder only; no access to the user's visible Drive files.
# ACCESS-ONLY: access_type=online, PKCE S256; refresh tokens are never requested or stored.
# Sessions expire at the actual access token expiry, capped at 1 hour; sign in again afterward.
# Google's external Testing-mode 7-day refresh-token rule does not extend these access-only sessions.
# Use separate development/production clients and random session keys; never use VITE_ prefixes.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Register this exact redirect URI: https://your-domain/api/google-drive?action=callback
# Local Web application redirect: http://127.0.0.1:5173/api/google-drive?action=callback
GOOGLE_DRIVE_CALLBACK_URL=
# Canonical base64 of exactly 32 random bytes; generate with the Node command above.
# Store as Sensitive on Vercel; rotating this key invalidates Google Drive cookies only.
GOOGLE_DRIVE_SESSION_SECRET=
# Same-origin /api/google-drive actions: GET session/start/callback/check/list/download,
# POST upload/logout (Origin and X-Roamlet-Request: 1 required). Download requires id and size.
# Only binary ROAMLET v1 ciphertext >=52 bytes and <=3 MiB is relayed; no passwords or plaintext.
# Complete listings allow at most 1000 files / 10 pages; larger listings fail explicitly.
# Upload checks snapshot metadata first and refuses 1000 existing backups; 999 allows one new file.
# Preflight is not a lock: concurrent clients or external writes can race the check.
# No automatic retention/deletion; simultaneous uploads can exceed the complete-listing cap.
# Total operation deadline is 20 seconds including bodies and preflight; no automatic retries or deletion.
# Logout clears cookies even if token revocation fails; a copied cookie cannot be centrally revoked.
# Exclude OAuth callback query strings, cookies and authorization headers from deployment logs.
# Official setup: https://developers.google.com/identity/protocols/oauth2/web-server
# appDataFolder: https://developers.google.com/workspace/drive/api/guides/appdata
