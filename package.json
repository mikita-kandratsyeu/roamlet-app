{
  "name": "roamlet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "client",
    "proxy"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "yarn workspace @roamlet/client build",
    "start": "yarn workspace @roamlet/proxy start",
    "preview": "yarn start",
    "typecheck": "yarn workspace @roamlet/client typecheck",
    "lint": "eslint .",
    "test": "yarn workspace @roamlet/client test && yarn workspace @roamlet/proxy test",
    "test:client": "yarn workspace @roamlet/client test",
    "test:proxy": "yarn workspace @roamlet/proxy test",
    "test:e2e": "yarn workspace @roamlet/client test:e2e",
    "test:offline": "yarn workspace @roamlet/client test:offline",
    "test:integration": "yarn workspace @roamlet/client test:integration",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependenciesMeta": {
    "esbuild": {
      "built": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
