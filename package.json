{
  "name": "roamlet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": "26.x"
  },
  "workspaces": [
    "client"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "yarn workspace @roamlet/client dev",
    "build": "yarn workspace @roamlet/client build",
    "check:ci": "yarn lint --cache --cache-strategy content --cache-location .yarn/ci-eslint.cache && yarn typecheck && yarn test",
    "start": "yarn workspace @roamlet/client preview",
    "preview": "yarn workspace @roamlet/client preview",
    "typecheck": "yarn workspace @roamlet/client typecheck",
    "lint": "eslint .",
    "test": "yarn test:server && yarn workspace @roamlet/client test",
    "test:server": "node --test server/*.test.mjs scripts/local-routing-api.test.mjs",
    "test:client": "yarn workspace @roamlet/client test",
    "test:e2e": "yarn workspace @roamlet/client test:e2e",
    "test:offline": "yarn workspace @roamlet/client test:offline",
    "test:layout": "node --test client/src/components/*.layout.test.mjs",
    "test:regression": "yarn lint && yarn typecheck && yarn test && yarn test:layout && yarn build && yarn test:e2e --output=test-results/e2e && yarn test:offline --output=test-results/offline",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependenciesMeta": {
    "esbuild": {
      "built": true
    }
  },
  "resolutions": {
    "minimatch@npm:^10.2.2": "npm:^11.0.1",
    "minimatch@npm:^10.2.4": "npm:^11.0.1",
    "minimatch@npm:^10.2.6": "npm:^11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
