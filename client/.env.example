# Mapbox Directions only. Public browser token (pk.); never use a secret token here.
# Maps, saved routes and GPX work without this token; online routing does not.
VITE_MAPBOX_ACCESS_TOKEN=
# Optional MapLibre style URL. Defaults to OpenFreeMap; no map token required.
VITE_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty

