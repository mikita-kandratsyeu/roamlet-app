# Hosted OpenRouteService routing only. Key is visible in the browser and built assets.
# Never commit an actual key. Monitor account quotas; use a server proxy for public/shared apps.
# Maps, manual planning, saved routes and GPX work without this key; online routing does not.
VITE_ORS_API_KEY=
# Optional MapLibre style URL. Defaults to OpenFreeMap; no map token required.
VITE_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty

