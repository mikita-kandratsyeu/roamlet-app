# OpenStreetMap public tiles: low-traffic development/personal use only.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION='© <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap contributors</a>'
VITE_TILE_MAX_ZOOM=19
# For another tile provider, replace BOTH the URL and its required attribution.

